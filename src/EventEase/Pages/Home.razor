@page "/"
@inject EventService EventService
@inject AttendanceService Attendance
@inject UserSessionService Session

<PageTitle>EventEase · Gestione eventi</PageTitle>

<section class="hero rounded-4 p-4 p-md-5 mb-4">
    <h1 class="display-6 fw-semibold mb-2">
        @if (Session.CurrentUser is { } user)
        {
            <text>Bentornato, @user.Name!</text>
        }
        else
        {
            <text>Organizza, partecipa, monitora.</text>
        }
    </h1>
    <p class="lead mb-4">EventEase semplifica la gestione di eventi aziendali e sociali: scopri gli eventi, registrati in pochi secondi e tieni traccia delle presenze.</p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-light btn-lg" href="events">Scopri gli eventi</a>
        <a class="btn btn-outline-light btn-lg" href="attendance">Monitoraggio presenze</a>
    </div>
</section>

@if (_events is null)
{
    <LoadingIndicator Text="Caricamento eventi…" />
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="stat-tile">
                <span class="stat-tile__value">@_upcoming.Count</span>
                <span class="stat-tile__label">Eventi in programma</span>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="stat-tile">
                <span class="stat-tile__value">@_totalRegistrations</span>
                <span class="stat-tile__label">Iscrizioni totali</span>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="stat-tile">
                <span class="stat-tile__value">@_categories.Count</span>
                <span class="stat-tile__label">Categorie</span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="h4 mb-0">Prossimi eventi</h2>
        <a href="events">Vedi tutti</a>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var ev in _upcoming.Take(3))
        {
            <div class="col-lg-4" @key="ev.Id">
                <EventCard Event="ev" RegisteredCount="Attendance.GetRegisteredCount(ev.Id)" />
            </div>
        }
    </div>

    <h2 class="h4 mb-3">Esplora per categoria</h2>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var category in _categories)
        {
            <a class="btn btn-outline-primary btn-sm" href="events?category=@Uri.EscapeDataString(category)">@category</a>
        }
    </div>
}

@code {
    private IReadOnlyList<EventItem>? _events;
    private List<EventItem> _upcoming = [];
    private IReadOnlyList<string> _categories = [];
    private int _totalRegistrations;

    protected override async Task OnInitializedAsync()
    {
        _events = await EventService.GetEventsAsync();
        _categories = await EventService.GetCategoriesAsync();

        var now = DateTime.Now;
        _upcoming = _events.Where(e => e.Date > now).ToList();
        _totalRegistrations = _events.Sum(e => Attendance.GetRegisteredCount(e.Id));
    }
}
